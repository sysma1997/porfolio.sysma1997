---
const { title, projects, descriptions } = Astro.props as {
    title: string;
    projects: Array<{
        id: string;
        name: string; icon?: string; coverImage?: string;
        tags: Array<{ icon: { prefix: string; name: string }; name: string }>;
        links?: Array<{ icon?: { prefix: string; name: string }; image?: string; name: string; url: string; target?: string }>;
    }>;
    descriptions: Record<string, string>;
};
---

<section id="projects" class="section">
    <div class="section-header">
        <h2>{title}</h2>
        <div class="section-line"></div>
    </div>
    <div class="grid">
        {projects && projects.map((project) =>
            <div class="card">
                <div class="card-header">
                    {project.icon && <img src={project.icon} alt={project.name} loading="lazy" />}
                    <h3>{project.name}</h3>
                </div>
                <div class="card-body">
                    {project.coverImage && <img class="cover" src={project.coverImage} alt={project.name} loading="lazy" />}
                    <p class="description">{descriptions[project.id]}</p>
                    <div class="tags">
                    {project.tags.map((tag) =>
                        <span class="tag">
                            <i class={`${tag.icon.prefix} ${tag.icon.name}`} />
                            {tag.name}
                        </span>
                    )}
                </div>
                <div class="links">
                    {project.links && project.links.map((link) =>
                        <a href={link.url} target={link.target || "_blank"} rel="noopener noreferrer">
                                {link.image ? <img src={link.image} alt={link.name} loading="lazy" /> : <i class={`${link.icon.prefix} ${link.icon.name}`} />}
                                {link.name}
                            </a>
                        )}
                    </div>
                </div>
            </div>
        )}
    </div>
</section>

<style>
    #projects {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .grid {
        width: 90%;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem;
        justify-items: center;
    }

    .card {
        width: 100%;
        background: var(--bg-card);
        border-radius: var(--radius);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all var(--transition);
    }
    .card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-4px);
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.8rem 1rem;
        border-bottom: 1px solid var(--border);
    }
    .card-header img { width: 20px; height: 20px; border-radius: 5px; flex-shrink: 0; }
    .card-header h3 {
        font-size: 0.95rem;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-body {
        padding: 0.8rem 1rem 1rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .card-body .cover {
        border-radius: var(--radius-sm);
        margin-bottom: 0.6rem;
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
    }
    .card-body .description {
        min-height: 74px;
        color: var(--text-secondary);
        font-size: 0.8rem;
        line-height: 1.45;
        margin-bottom: 0.6rem;

        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        margin-bottom: 0.6rem;
    }
    .tags .tag {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: rgba(113, 67, 133, 0.1);
        color: var(--primary);
        padding: 0.2rem 0.5rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 500;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: auto;
    }
    .links a {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        padding: 0.3rem 0.7rem;
        border-radius: var(--radius-sm);
        font-size: 0.72rem;
        font-weight: 500;
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--text-secondary);
        transition: all var(--transition);
    }
    .links a:hover {
        background: var(--primary);
        border-color: var(--primary);
        color: white;
    }
    .links a img { width: 14px; height: 14px; }

    @media (max-width: 1024px) {
        .grid { width: 92%; }
    }

    @media (max-width: 850px) {
        .grid {
            width: 100%;
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .grid { grid-template-columns: 1fr; }
        .card-body { padding-bottom: 0.8rem; }
    }
</style>