		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/imgs/gum-fall-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Gum Fall — Privacy Policy</title>
        <meta name="description" content="Privacy policy for Gum Fall by SYSMA." />
        <meta property="og:title" content="Gum Fall — Privacy Policy" />
        <meta property="og:description" content="Privacy policy for Gum Fall by SYSMA." />
        <meta property="og:url" content="https://sysma1997.github.io/gum-fall/privacy-polices/" />
        <meta property="og:type" content="website" />
        <link rel="canonical" href="https://sysma1997.github.io/gum-fall/privacy-polices/" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css" />
		<script src="https://kit.fontawesome.com/c8146c06e1.js" crossorigin="anonymous"></script>
        <script is:inline>
            (function() {
                var saved = localStorage.getItem("theme");
                var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
                var theme = saved || (prefersDark ? "dark" : "light");
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>
	</head>
